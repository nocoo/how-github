{
  "name": "how-github",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive research atlas of GitHub's business and developer ecosystem.",
  "engines": { "node": ">=22.18.0" },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "npm test && cf deploy",
    "test": "python3 tests/verify.py && node --check assets/app.js && node --test tests/build.test.mjs",
    "test:browser": "node tests/browser.cjs"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.13",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "zod": "^4.6.6"
  }
}
